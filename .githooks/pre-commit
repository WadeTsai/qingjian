#!/usr/bin/env bash
# 啟用：git config core.hooksPath .githooks；跳過：git commit --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# 裝飾性分隔註釋（`// ====` / `// ────`）不要：只做視覺分組、不帶任何「為什麼」，用空行加語義排序分組
staged_rs="$(git diff --cached --name-only --diff-filter=ACM -- '*.rs')"
if [[ -n "$staged_rs" ]]; then
  matches="$(echo "$staged_rs" | xargs grep -nE '^\s*//[/!]?\s*[=─-]{3,}\s*$' 2>/dev/null || true)"
  if [[ -n "$matches" ]]; then
    echo "$matches"
    echo "装饰性分隔注释不要，用空行 + 语义排序分组" >&2
    exit 1
  fi
fi

cargo fmt --all --check

# clippy 要按平臺排除編不了的殼，劃分與 ci.yml 的三個 job 一致。
# IMK 殼依賴 objc2，非 Apple 平臺上是硬 compile_error!，排除不掉就只能整條命令失敗；
# 其餘平臺排除它之後，Windows 三件套在本機也編得過（已在 Windows 上驗過）。
case "$(uname -s)" in
  Darwin) clippy_scope=(--workspace) ;;
  *) clippy_scope=(--workspace --exclude qingjian-macos) ;;
esac
cargo clippy "${clippy_scope[@]}" --all-targets -- -D warnings
