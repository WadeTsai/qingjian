#!/usr/bin/env bash
# 推之前跑全 workspace 測試（提交時不跑，太慢）；跳過：git push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
# 與 pre-commit 同一套平臺劃分（理由見那邊）：非 Apple 平臺編不了依賴 objc2 的 IMK 殼。
case "$(uname -s)" in
  Darwin)
    test_scope=(--workspace)
    ;;
  MINGW*|MSYS*|CYGWIN*)
    # Server 的 build.rs 會嵌 uiAccess manifest，嵌了它的測試二進位制沒簽名起不來（os error 740）；
    # 與 ci.yml 的 windows job 一樣關掉
    test_scope=(--workspace --exclude qingjian-macos)
    export QINGJIAN_UIACCESS=0
    ;;
  *)
    test_scope=(--workspace --exclude qingjian-macos)
    ;;
esac
cargo test "${test_scope[@]}" --locked
